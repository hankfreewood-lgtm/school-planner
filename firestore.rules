rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validSubject(s) {
      return s is string && s in [
        'Mathematik', 'Deutsch', 'Englisch', 'Biologie', 'Chemie', 'Physik',
        'Geschichte', 'Geografie', 'Informatik', 'Musik', 'Kunst', 'Sport',
        'Sozialkunde', 'Sonstiges'
      ];
    }

    // Datum als ISO-String "JJJJ-MM-TT" (kalendarisch, ohne Zeitzone)
    function validDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validText(t, max) {
      return t is string && t.size() > 0 && t.size() <= max;
    }

    function validHomework(d) {
      return d.keys().hasOnly(['subject', 'content', 'dueDate', 'completed', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['subject', 'content', 'dueDate', 'completed'])
        && validSubject(d.subject)
        && validText(d.content, 1000)
        && validDate(d.dueDate)
        && d.completed is bool;
    }

    function validTest(d) {
      return d.keys().hasOnly(['subject', 'topic', 'testDate', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['subject', 'topic', 'testDate'])
        && validSubject(d.subject)
        && validText(d.topic, 1000)
        && validDate(d.testDate);
    }

    function validPreferences(d) {
      return d.keys().hasOnly(['theme', 'subjectTint', 'updatedAt'])
        && d.theme in ['light', 'dark', 'system']
        && d.subjectTint is bool;
    }

    match /users/{userId} {
      // Profildokument
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt']);
      allow delete: if isOwner(userId);

      match /homework/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validHomework(request.resource.data);
      }

      match /tests/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTest(request.resource.data);
      }

      match /settings/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && id == 'preferences'
          && validPreferences(request.resource.data);
      }
    }

    // Alles andere ist gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
