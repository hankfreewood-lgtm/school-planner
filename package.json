{
  "name": "school-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Moderner Schulplaner als PWA (Hausaufgaben & Tests) mit Firebase",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
